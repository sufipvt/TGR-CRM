# Copy to .env.development.local for local runs (config/env.js loads it when
# NODE_ENV is not "production"). On Render, set these in the service's
# Environment tab. Never commit real values.

# --- Required -----------------------------------------------------------
# MongoDB Atlas connection string (one database per client deployment)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/crm
# Signs login sessions. 32+ random characters, different per deployment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# --- Runtime ------------------------------------------------------------
NODE_ENV=development
PORT=3000

# --- First boot only ----------------------------------------------------
# Used once, when the database has no users, to create the first Super Admin.
# Remove SEED_ADMIN_PASSWORD after the first successful start.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Optional integrations ----------------------------------------------
# Daily follow-up digest email (skipped if unset)
SENDGRID_API_KEY=
SENDGRID_FROM=crm@yourdomain.com
# Link used in the digest's "Open CRM" button
APP_URL=https://your-crm.onrender.com
# AI chat assistant (quick commands still work if unset)
GROQ_API_KEY=
