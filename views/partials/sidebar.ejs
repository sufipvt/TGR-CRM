<!-- SIDEBAR -->
<nav class="tg-sidebar" aria-label="Main navigation">
  <div class="tg-sidebar-brand">
    <div class="tg-logo" aria-hidden="true"><%= brand.initials %></div>
    <div>
      <div class="tg-brand-name"><%= brand.shortName %></div>
      <div class="tg-brand-sub">Real Estate CRM</div>
    </div>
  </div>
  <div class="tg-nav">
    <% navItems.forEach(item => { %>
      <a href="/app?page=<%= item.page %>" class="tg-nav-link <%= page === item.page ? 'active' : '' %>">
        <i class="fa-solid <%= item.icon %>" aria-hidden="true"></i> <%= item.label %>
      </a>
    <% }) %>
  </div>
  <div class="tg-sidebar-footer">
    <form method="POST" action="/logout" class="m-0"><button type="submit" class="tg-nav-link border-0 bg-transparent w-100 text-start"><i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i> Logout</button></form>
  </div>
</nav>
