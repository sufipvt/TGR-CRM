    <div class="tg-panel" style="max-width:640px;">
      <h2 class="tg-panel-title">Company Settings</h2>
      <form method="POST" action="/app?page=settings">
        <input type="hidden" name="action" value="save_settings">
        <div class="row g-3">
          <div class="col-md-6"><label class="form-label" for="st_company">Company Name</label><input class="form-control" id="st_company" name="company_name" value="<%= data.settings.company_name %>"></div>
          <div class="col-md-3"><label class="form-label" for="st_currency">Currency</label><input class="form-control" id="st_currency" name="currency" value="<%= data.settings.currency %>"></div>
          <div class="col-md-3"><label class="form-label" for="st_symbol">Symbol</label><input class="form-control" id="st_symbol" name="currency_symbol" value="<%= data.settings.currency_symbol %>"></div>
          <div class="col-md-4"><label class="form-label" for="st_tax">Tax Rate (%)</label><input type="number" step="0.01" class="form-control" id="st_tax" name="tax_rate" value="<%= data.settings.tax_rate %>"></div>
          <div class="col-md-4"><label class="form-label" for="st_bprefix">Booking Prefix</label><input class="form-control" id="st_bprefix" name="booking_prefix" value="<%= data.settings.booking_prefix %>"></div>
          <div class="col-md-4"><label class="form-label" for="st_lprefix">Lead Prefix</label><input class="form-control" id="st_lprefix" name="lead_prefix" value="<%= data.settings.lead_prefix %>"></div>
          <div class="col-md-6"><label class="form-label" for="st_comm">Default Commission (%)</label><input type="number" step="0.01" class="form-control" id="st_comm" name="default_commission" value="<%= data.settings.default_commission %>"></div>
        </div>
        <h3 class="h6 fw-semibold mt-4 mb-1">Contact details for customers</h3>
        <p class="text-secondary mb-3" style="font-size:13px;">Shown on your public <a href="/privacy" target="_blank" rel="noopener">Privacy Policy</a> and <a href="/terms" target="_blank" rel="noopener">Terms of Use</a>, where customers can ask about their data.</p>
        <div class="row g-3">
          <div class="col-md-6"><label class="form-label" for="st_cemail">Contact Email</label><input type="email" class="form-control" id="st_cemail" name="contact_email" maxlength="120" value="<%= data.settings.contact_email || '' %>"></div>
          <div class="col-md-6"><label class="form-label" for="st_cphone">Contact Phone</label><input type="tel" class="form-control" id="st_cphone" name="contact_phone" maxlength="30" value="<%= data.settings.contact_phone || '' %>"></div>
          <div class="col-12"><label class="form-label" for="st_caddr">Office Address</label><input class="form-control" id="st_caddr" name="company_address" maxlength="300" value="<%= data.settings.company_address || '' %>"></div>
        </div>
        <button type="submit" class="btn btn-primary mt-4">Save Settings</button>
      </form>
    </div>


    <div class="tg-panel mt-3" style="max-width:640px;">
      <h2 class="tg-panel-title">Lead capture</h2>
      <p class="mb-0" style="font-size:14px;">The enquiry form, Google Ads, Facebook, property portals and other lead sources are set up on the <a href="/app?page=integrations">Integrations</a> page.</p>
    </div>

    <% if (data.unfixed_followups > 0) { %>
      <div class="tg-panel mt-3" style="max-width:640px;">
        <h2 class="tg-panel-title">Fix old follow-up times</h2>
        <p class="mb-3">
          <strong><%= data.unfixed_followups.toLocaleString('en-IN') %></strong> follow-up<%= data.unfixed_followups === 1 ? ' was' : 's were' %> saved before the CRM switched to India time
          and now show 5h30 late (10:00 shows as 15:30). This moves them back to the time that was typed in.
          It only needs doing once, and this box disappears afterwards.
        </p>
        <form method="POST" action="/app?page=settings"
              onsubmit="return confirm('Move <%= data.unfixed_followups %> old follow-ups back by 5h30?')">
          <input type="hidden" name="action" value="fix_followup_times">
          <button type="submit" class="btn btn-warning">Fix old follow-up times</button>
        </form>
      </div>
    <% } %>
