    <div class="tg-panel" style="max-width:640px;">
      <h2 class="tg-panel-title">Company Settings</h2>
      <form method="POST" action="/app?page=settings">
        <input type="hidden" name="action" value="save_settings">
        <div class="row g-3">
          <div class="col-md-6"><label class="form-label" for="st_company">Company Name</label><input class="form-control" id="st_company" name="company_name" value="<%= data.settings.company_name %>"></div>
          <div class="col-md-3"><label class="form-label" for="st_currency">Currency</label><input class="form-control" id="st_currency" name="currency" value="<%= data.settings.currency %>"></div>
          <div class="col-md-3"><label class="form-label" for="st_symbol">Symbol</label><input class="form-control" id="st_symbol" name="currency_symbol" value="<%= data.settings.currency_symbol %>"></div>
          <div class="col-md-4"><label class="form-label" for="st_tax">Tax Rate (%)</label><input type="number" step="0.01" class="form-control" id="st_tax" name="tax_rate" value="<%= data.settings.tax_rate %>"></div>
          <div class="col-md-4"><label class="form-label" for="st_bprefix">Booking Prefix</label><input class="form-control" id="st_bprefix" name="booking_prefix" value="<%= data.settings.booking_prefix %>"></div>
          <div class="col-md-4"><label class="form-label" for="st_lprefix">Lead Prefix</label><input class="form-control" id="st_lprefix" name="lead_prefix" value="<%= data.settings.lead_prefix %>"></div>
          <div class="col-md-6"><label class="form-label" for="st_comm">Default Commission (%)</label><input type="number" step="0.01" class="form-control" id="st_comm" name="default_commission" value="<%= data.settings.default_commission %>"></div>
        </div>
        <h3 class="h6 fw-semibold mt-4 mb-1">Contact details for customers</h3>
        <p class="text-secondary mb-3" style="font-size:13px;">Shown on your public <a href="/privacy" target="_blank" rel="noopener">Privacy Policy</a> and <a href="/terms" target="_blank" rel="noopener">Terms of Use</a>, where customers can ask about their data.</p>
        <div class="row g-3">
          <div class="col-md-6"><label class="form-label" for="st_cemail">Contact Email</label><input type="email" class="form-control" id="st_cemail" name="contact_email" maxlength="120" value="<%= data.settings.contact_email || '' %>"></div>
          <div class="col-md-6"><label class="form-label" for="st_cphone">Contact Phone</label><input type="tel" class="form-control" id="st_cphone" name="contact_phone" maxlength="30" value="<%= data.settings.contact_phone || '' %>"></div>
          <div class="col-12"><label class="form-label" for="st_caddr">Office Address</label><input class="form-control" id="st_caddr" name="company_address" maxlength="300" value="<%= data.settings.company_address || '' %>"></div>
        </div>
        <button type="submit" class="btn btn-primary mt-4">Save Settings</button>
      </form>
    </div>


    <div class="tg-panel mt-3" style="max-width:640px;">
      <h2 class="tg-panel-title">Lead capture</h2>
      <p class="text-secondary" style="font-size:14px;">Optional. Leads that arrive here are assigned automatically, like CSV imports. A phone number already in the CRM adds a note to that lead instead of a second lead.</p>
      <form method="POST" action="/app?page=settings">
        <input type="hidden" name="action" value="save_lead_capture">
        <div class="form-check form-switch mb-2">
          <input class="form-check-input" type="checkbox" role="switch" id="cap_form" name="capture_form_enabled" value="1" <%= data.capture.formEnabled ? 'checked' : '' %>>
          <label class="form-check-label fw-medium" for="cap_form">Enquiry form link</label>
        </div>
        <div class="ms-4 mb-3" style="font-size:14px;">
          <p class="text-secondary mb-2">A page with your company name where buyers leave their details. Put the link on your website, Instagram bio or WhatsApp.</p>
          <% const formUrl = data.base_url + '/enquire'; %>
          <div class="input-group mb-2">
            <input class="form-control" id="cap_form_url" value="<%= formUrl %>" readonly aria-label="Enquiry form link">
            <button type="button" class="btn btn-outline-secondary" onclick="tgCopy('cap_form_url', this)">Copy</button>
            <% if (data.capture.formEnabled) { %><a class="btn btn-outline-primary" href="/enquire" target="_blank" rel="noopener">Open</a><% } %>
          </div>
          <label class="form-label" for="cap_link_project">Link for one project</label>
          <select class="form-select mb-1" id="cap_link_project" data-base="<%= formUrl %>"
            onchange="document.getElementById('cap_form_url').value = this.dataset.base + (this.value ? '?project=' + this.value : '')">
            <option value="">All projects (buyer picks)</option>
            <% data.projects.forEach(p => { %><option value="<%= p._id %>"><%= p.name %></option><% }) %>
          </select>
          <p class="text-secondary mb-3" style="font-size:13px;">Picks that project on the form. To see which ad or post a lead came from, add <code>?utm_source=instagram&amp;utm_campaign=diwali</code> (or <code>&amp;utm_source=…</code> after a project link). The buyer's answers set the lead to Hot, Warm or Cold, and the assigned agent gets a first call on their follow-ups: Hot within 15 minutes, Warm within 2 hours, Cold the next morning.</p>
          <label class="form-label" for="cap_source">Mark these leads as source</label>
          <select class="form-select" id="cap_source" name="capture_source_id">
            <option value="">Website Enquiry (created automatically)</option>
            <% data.sources.forEach(s => { %><option value="<%= s._id %>" <%= String(s._id) === String(data.capture.formSourceId) ? 'selected' : '' %>><%= s.name %></option><% }) %>
          </select>
        </div>
        <div class="form-check form-switch mb-2">
          <input class="form-check-input" type="checkbox" role="switch" id="cap_hook" name="capture_webhook_enabled" value="1" <%= data.capture.webhookEnabled ? 'checked' : '' %>>
          <label class="form-check-label fw-medium" for="cap_hook">Webhook (Google Ads, Zapier, Pabbly, portals)</label>
        </div>
        <div class="ms-4 mb-3" style="font-size:14px;">
          <p class="text-secondary mb-2">Other tools send leads here. Send JSON or form fields <code>name</code>, <code>phone</code> and optionally <code>email</code>, <code>city</code>, <code>project</code>, <code>source</code>, <code>notes</code>, with the key in an <code>X-Api-Key</code> header. In Google Ads, paste the URL and the key into the lead form's webhook settings.</p>
          <div class="input-group mb-2">
            <input class="form-control" id="cap_hook_url" value="<%= data.base_url %>/api/leads/capture" readonly aria-label="Webhook URL">
            <button type="button" class="btn btn-outline-secondary" onclick="tgCopy('cap_hook_url', this)">Copy</button>
          </div>
          <% if (data.capture.webhookKey) { %>
            <div class="input-group">
              <input class="form-control font-monospace" id="cap_hook_key" type="password" value="<%= data.capture.webhookKey %>" readonly aria-label="Webhook key">
              <button type="button" class="btn btn-outline-secondary" onclick="const k=document.getElementById('cap_hook_key');k.type=k.type==='password'?'text':'password'">Show</button>
              <button type="button" class="btn btn-outline-secondary" onclick="tgCopy('cap_hook_key', this)">Copy</button>
            </div>
          <% } else { %>
            <p class="text-secondary mb-0">A secret key is created when you turn this on.</p>
          <% } %>
        </div>
        <button type="submit" class="btn btn-primary">Save lead capture</button>
      </form>
      <% if (data.capture.webhookKey) { %>
        <form method="POST" action="/app?page=settings" class="mt-2" onsubmit="return confirm('Create a new key? Anything using the old key will stop sending leads until you update it.')">
          <input type="hidden" name="action" value="regenerate_capture_key">
          <button type="submit" class="btn btn-sm btn-outline-danger">Create a new key</button>
        </form>
      <% } %>
    </div>

    <% if (data.unfixed_followups > 0) { %>
      <div class="tg-panel mt-3" style="max-width:640px;">
        <h2 class="tg-panel-title">Fix old follow-up times</h2>
        <p class="mb-3">
          <strong><%= data.unfixed_followups.toLocaleString('en-IN') %></strong> follow-up<%= data.unfixed_followups === 1 ? ' was' : 's were' %> saved before the CRM switched to India time
          and now show 5h30 late (10:00 shows as 15:30). This moves them back to the time that was typed in.
          It only needs doing once, and this box disappears afterwards.
        </p>
        <form method="POST" action="/app?page=settings"
              onsubmit="return confirm('Move <%= data.unfixed_followups %> old follow-ups back by 5h30?')">
          <input type="hidden" name="action" value="fix_followup_times">
          <button type="submit" class="btn btn-warning">Fix old follow-up times</button>
        </form>
      </div>
    <% } %>
