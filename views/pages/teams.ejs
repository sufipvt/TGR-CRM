    <div class="d-flex justify-content-end mb-3">
      <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#teamModal" onclick="tgResetTeamForm()"><i class="fa-solid fa-plus me-1" aria-hidden="true"></i>Create Team</button>
    </div>

    <div class="row g-3">
      <% if (!data.teams_detail || !data.teams_detail.length) { %>
        <div class="col-12"><div class="tg-panel text-center text-secondary py-5">No teams yet. Create your first team to start assigning agents.</div></div>
      <% } %>
      <% (data.teams_detail || []).forEach(t => { %>
        <div class="col-md-6 col-xl-4">
          <div class="tg-panel h-100">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <div>
                <h2 class="h6 fw-bold mb-1"><%= t.name %></h2>
                <div class="text-secondary" style="font-size:13px;">
                  <i class="fa-solid fa-user-tie me-1" aria-hidden="true"></i>
                  <%= t.team_leader_id ? t.team_leader_id.full_name : 'No Team Leader assigned' %>
                </div>
              </div>
              <span class="badge text-bg-info"><%= t.members.length %> member<%= t.members.length !== 1 ? 's' : '' %></span>
            </div>

            <div class="mt-3" style="font-size:13px;">
              <% if (!t.members.length) { %>
                <p class="text-secondary mb-0">No members assigned yet.</p>
              <% } else { %>
                <% t.members.forEach(m => { %>
                  <div class="d-flex justify-content-between align-items-center py-1 border-bottom">
                    <span><%= m.full_name %></span>
                    <span class="badge text-bg-<%= m.role === 'Team Leader' ? 'dark' : 'light' %> border" style="font-size:10px;"><%= m.role %></span>
                  </div>
                <% }) %>
              <% } %>
            </div>

            <div class="d-flex gap-2 mt-3">
              <button class="btn btn-sm btn-outline-primary" aria-label="Edit team"
                onclick='tgEditTeam(<%= JSON.stringify({
                  _id: String(t._id), name: t.name,
                  team_leader_id: t.team_leader_id ? String(t.team_leader_id._id) : ""
                }) %>)'><i class="fa-solid fa-pen me-1" aria-hidden="true"></i>Edit</button>
              <form method="POST" action="/app?page=teams" class="d-inline" onsubmit="return confirm('Delete this team? Members must be reassigned first.')"><input type="hidden" name="action" value="delete"><input type="hidden" name="table" value="teams"><input type="hidden" name="id" value="<%= t._id %>"><button type="submit" class="btn btn-sm btn-outline-danger" aria-label="Delete team"><i class="fa-solid fa-trash me-1" aria-hidden="true"></i>Delete</button></form>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

    <% if (data.unassigned_users && data.unassigned_users.length) { %>
    <div class="tg-panel mt-3">
      <h2 class="tg-panel-title">Unassigned Users</h2>
      <p class="text-secondary" style="font-size:13px;">These users aren't in any team yet. Assign them from the Users page.</p>
      <div class="d-flex flex-wrap gap-2">
        <% data.unassigned_users.forEach(u => { %>
          <span class="badge text-bg-light border py-2 px-3"><%= u.full_name %> <span class="text-secondary">(<%= u.role %>)</span></span>
        <% }) %>
      </div>
    </div>
    <% } %>

    <!-- Team Modal -->
    <div class="modal fade" id="teamModal" tabindex="-1" aria-labelledby="teamModalTitle" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <form method="POST" action="/app?page=teams">
            <div class="modal-header">
              <h2 class="modal-title h5" id="teamModalTitle">Create Team</h2>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <input type="hidden" name="action" value="add_team" id="tmAction">
              <input type="hidden" name="team_id" id="tmId">
              <div class="mb-3">
                <label class="form-label" for="tm_name">Team Name *</label>
                <input class="form-control" id="tm_name" name="name" required placeholder="e.g. North Zone Sales">
              </div>
              <div class="mb-0">
                <label class="form-label" for="tm_leader">Team Leader</label>
                <select class="form-select" id="tm_leader" name="team_leader_id">
                  <option value="">None yet</option>
                  <% (data.all_agents || []).forEach(u => { %>
                    <option value="<%= u._id %>"><%= u.full_name %> <%= u.role !== 'Sub Team Leader' ? '(' + u.role + ')' : '' %></option>
                  <% }) %>
                </select>
                <div class="text-secondary mt-1" style="font-size:12px;">Selecting a user here promotes them to Team Leader.</div>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-primary">Save Team</button>
            </div>
          </form>
        </div>
      </div>
    </div>

