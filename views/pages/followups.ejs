    <%
      const now = new Date();
      const sot = new Date(); sot.setHours(0,0,0,0);
      const eot = new Date(); eot.setHours(23,59,59,999);
      const buckets = [
        { key: 'overdue', label: 'Overdue', cls: 'danger', items: data.followups.filter(f => f.status === 'Pending' && f.scheduled_date < sot) },
        { key: 'today', label: 'Today', cls: 'primary', items: data.followups.filter(f => f.status === 'Pending' && f.scheduled_date >= sot && f.scheduled_date <= eot) },
        { key: 'upcoming', label: 'Upcoming', cls: 'success', items: data.followups.filter(f => f.status === 'Pending' && f.scheduled_date > eot) },
        { key: 'done', label: 'Done', note: 'Completed / Other (last ' + data.followup_history_days + ' days)', cls: 'secondary', items: data.followups.filter(f => f.status !== 'Pending') }
      ];
      // Open on the first tab with something to do; Today when nothing is pending.
      const firstTab = (buckets.slice(0, 3).find(b => b.items.length) || buckets[1]).key;
      const chip = s => 'tg-chip tg-chip-' + String(s).toLowerCase().replace(/ /g, '-');
    %>
    <div class="tg-panel">
      <div class="d-flex flex-wrap align-items-end gap-2 mb-3">
        <nav class="tg-status-tabs flex-grow-1" aria-label="Follow-ups by when" data-tabs>
          <% buckets.forEach(bucket => { %>
            <button type="button" data-tab="<%= bucket.key %>" class="<%= bucket.key === firstTab ? 'active' : '' %><%= bucket.key === 'overdue' && bucket.items.length ? ' tg-tab-alert' : '' %>" aria-pressed="<%= bucket.key === firstTab %>"><%= bucket.label %> <span class="tg-tab-count"><%= bucket.items.length %></span></button>
          <% }) %>
        </nav>
        <button data-quick="new" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#followupModal" onclick="tgResetFollowupForm()"><i class="fa-solid fa-plus me-1" aria-hidden="true"></i>Schedule Follow-Up</button>
      </div>
    <% buckets.forEach(bucket => { %>
      <section data-tab-panel="<%= bucket.key %>" aria-label="<%= bucket.label %>"<%= bucket.key === firstTab ? '' : ' hidden' %>>
        <% if (bucket.note) { %><p class="text-secondary mb-2" style="font-size:13px;"><%= bucket.note %></p><% } %>
        <% if (!bucket.items.length) { %>
          <p class="text-secondary mb-0 py-3" style="font-size:14px;">Nothing here.</p>
        <% } else { %>
          <div class="table-responsive">
            <table class="table tg-table tg-stack align-middle mb-0">
              <thead><tr><th>Lead</th><th>Type</th><th>Owner</th><th>When</th><th>Notes</th><th>Outcome</th><th>Status</th><th>Actions</th></tr></thead>
              <tbody>
                <% bucket.items.forEach(f => { %>
                  <tr>
                    <td class="tg-c-lead fw-medium"><%= f.lead_id ? f.lead_id.name : '—' %><div class="text-secondary" style="font-size:12px;"><%= f.lead_id ? f.lead_id.phone : '' %></div></td>
                    <td class="tg-c-type"><span class="tg-chip"><%= f.type %></span></td>
                    <td class="tg-c-owner<%= isManager ? '' : ' tg-m-hide' %>"><%= f.assigned_to_id ? f.assigned_to_id.full_name : '—' %></td>
                    <td class="tg-c-when<%= bucket.key === 'overdue' ? ' tg-overdue' : '' %>" style="font-size:13px;"><%= formatDateTime(f.scheduled_date) %></td>
                    <td class="tg-c-notes<%= f.notes ? '' : ' tg-m-hide' %> text-secondary" style="font-size:13px;max-width:180px;"><%= f.notes || '—' %></td>
                    <td class="tg-c-outcome<%= f.outcome || f.visit_outcome ? '' : ' tg-m-hide' %> text-secondary" style="font-size:13px;max-width:180px;"><% if (f.visit_outcome) { %><span class="badge text-bg-<%= f.visit_outcome === 'Interested' ? 'success' : (f.visit_outcome === 'No show' || f.visit_outcome === 'Not interested' ? 'danger' : 'secondary') %> me-1"><%= f.visit_outcome %></span><% } %><%= f.outcome || (f.visit_outcome ? '' : '—') %></td>
                    <td class="tg-c-status"><span class="<%= chip('fu-' + f.status) %>"><%= f.status %></span></td>
                    <td class="tg-c-actions text-nowrap">
                      <% if (f.lead_id && f.status === 'Pending') { %><%- include('../partials/call-buttons', { lead: f.lead_id, log: true }) -%><% } %>
                      <% if (f.status === 'Pending') { %>
                        <button class="btn btn-sm btn-outline-success" title="Mark done" onclick='tgCompleteFollowup(<%= JSON.stringify(String(f._id)) %>, <%= JSON.stringify(f.type) %>)'>Done</button>
                      <% } %>
                      <button class="btn btn-sm btn-outline-primary" title="Edit" aria-label="Edit follow-up"
                        onclick='tgEditFollowup(<%= JSON.stringify({
                          _id: String(f._id), lead_id: f.lead_id ? String(f.lead_id._id) : "",
                          lead_label: f.lead_id ? f.lead_id.name + " (" + f.lead_id.phone + ")" : "",
                          assigned_to_id: f.assigned_to_id ? String(f.assigned_to_id._id) : "",
                          scheduled_date: toDateTimeInput(f.scheduled_date),
                          type: f.type, status: f.status, outcome: f.outcome || "", notes: f.notes || ""
                        }) %>)'><i class="fa-solid fa-pen" aria-hidden="true"></i></button>
                      <form method="POST" action="/app?page=followups" class="d-inline" onsubmit="return confirm('Delete this follow-up?')"><input type="hidden" name="action" value="delete"><input type="hidden" name="table" value="followups"><input type="hidden" name="id" value="<%= f._id %>"><button type="submit" class="btn btn-sm btn-outline-danger" title="Delete" aria-label="Delete follow-up"><i class="fa-solid fa-trash" aria-hidden="true"></i></button></form>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>
    <% }) %>
    </div>

    <!-- Complete follow-up hidden form -->
    <form method="POST" action="/app?page=followups" id="completeFuForm" class="d-none">
      <input type="hidden" name="action" value="complete_followup">
      <input type="hidden" name="followup_id" id="completeFuId">
      <input type="hidden" name="outcome" id="completeFuOutcome">
      <input type="hidden" name="visit_outcome" id="completeFuVisit">
    </form>

    <!-- Schedule/Edit Follow-Up Modal -->
    <div class="modal fade" id="followupModal" tabindex="-1" aria-labelledby="followupModalTitle" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <form method="POST" action="/app?page=followups">
            <div class="modal-header">
              <h2 class="modal-title h5" id="followupModalTitle">Schedule Follow-Up</h2>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <input type="hidden" name="action" value="add_followup" id="fuAction">
              <input type="hidden" name="followup_id" id="fuId">
              <div class="mb-3">
                <label class="form-label" for="fu_lead">Lead *</label>
                <select class="form-select" id="fu_lead" name="lead_id" required>
                  <option value="">Select lead</option>
                  <% data.leads_for_fu.forEach(l => { %><option value="<%= l._id %>"><%= l.name %> (<%= l.phone %>)</option><% }) %>
                </select>
              </div>
              <div class="mb-3">
                <label class="form-label" for="fu_type">Type</label>
                <select class="form-select" id="fu_type" name="type">
                  <% ['Call','WhatsApp','Site Visit','Meeting','Email','Other'].forEach(t => { %><option value="<%= t %>"><%= t %></option><% }) %>
                </select>
              </div>
              <% if (isManager) { %>
                <div class="mb-3">
                  <label class="form-label" for="fu_owner">Owner</label>
                  <select class="form-select" id="fu_owner" name="assigned_to_id">
                    <option value="">Me</option>
                    <% data.users.forEach(u => { %><option value="<%= u._id %>"><%= u.full_name %> (<%= u.role %>)</option><% }) %>
                  </select>
                </div>
              <% } %>
              <div class="mb-3">
                <label class="form-label" for="fu_date">Date &amp; Time *</label>
                <input type="datetime-local" class="form-control" id="fu_date" name="scheduled_date" required>
              </div>
              <div class="mb-3" id="fuStatusWrap" style="display:none;">
                <label class="form-label" for="fu_status">Status</label>
                <select class="form-select" id="fu_status" name="status">
                  <% ['Pending','Completed','Missed','Cancelled'].forEach(s => { %><option value="<%= s %>"><%= s %></option><% }) %>
                </select>
              </div>
              <div class="mb-3" id="fuOutcomeWrap" style="display:none;">
                <label class="form-label" for="fu_outcome">Outcome</label>
                <input class="form-control" id="fu_outcome" name="outcome">
              </div>
              <div class="mb-0">
                <label class="form-label" for="fu_notes">Notes</label>
                <textarea class="form-control" id="fu_notes" name="notes" rows="2"></textarea>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-primary">Save</button>
            </div>
          </form>
        </div>
      </div>
    </div>

