<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') -%>
<body>
<%
  const isSuperAdmin = user.role === 'Super Admin';
  const isAdminRole  = ['Super Admin','Admin'].includes(user.role);
  const isManager    = ['Super Admin','Admin','Team Leader'].includes(user.role);
  const isAdmin      = isSuperAdmin; // kept for backward compat elsewhere in this file

  const navItems = [];
  navItems.push({ page: 'dashboard', label: 'Dashboard', icon: 'fa-gauge-high' });
  navItems.push({ page: 'leads', label: isManager ? 'Leads' : 'My Leads', icon: 'fa-user-group' });
  navItems.push({ page: 'followups', label: isManager ? 'Follow-Ups' : 'My Follow-Ups', icon: 'fa-bell' });
  navItems.push({ page: 'bookings', label: 'Bookings', icon: 'fa-file-signature' });
 if (isManager) {
    navItems.push({ page: 'projects', label: 'Projects', icon: 'fa-building' });
    navItems.push({ page: 'sources', label: 'Lead Sources', icon: 'fa-bullseye' });
  }
  navItems.push({ page: 'reports', label: isManager ? 'Reports' : 'My Report', icon: 'fa-chart-line' });
  if (isSuperAdmin) {
    navItems.push({ page: 'teams', label: 'Teams', icon: 'fa-people-group' });
    navItems.push({ page: 'users', label: 'Users', icon: 'fa-users-gear' });
  }
  if (isAdminRole) {
    navItems.push({ page: 'settings', label: 'Settings', icon: 'fa-gear' });
    navItems.push({ page: 'audit', label: 'Audit Log', icon: 'fa-clock-rotate-left' });
  }
  const pageTitles = { dashboard: 'Dashboard', leads: 'Leads', followups: 'Follow-Ups', bookings: 'Bookings', projects: 'Projects', sources: 'Lead Sources', users: 'Users', teams: 'Teams', settings: 'Settings', reports: 'Reports', audit: 'Audit Log' };
  const statusColors = { 'New': 'primary', 'Working': 'warning', 'Qualified': 'info', 'Site Visit Scheduled': 'secondary', 'Negotiation': 'dark', 'Booked': 'success', 'Lost': 'danger', 'Not Interested': 'danger' };
%>

<%- include('partials/sidebar', { navItems }) -%>

<%- include('partials/topbar', { pageTitles }) -%>

<!-- CONTENT -->
<main class="tg-content">
<%- include('partials/flash') -%>

  <%# ======================= DASHBOARD ======================= %>
  <% if (page === 'dashboard') { %>
<%- include('pages/dashboard', { isManager, statusColors }) -%>
  <%# ======================= LEADS ======================= %>
  <% } else if (page === 'leads') { %>
<%- include('pages/leads', { isManager, statusColors }) -%>
  <%# ======================= FOLLOW-UPS ======================= %>
  <% } else if (page === 'followups') { %>
<%- include('pages/followups', { isManager }) -%>
  <%# ======================= BOOKINGS ======================= %>
  <% } else if (page === 'bookings') { %>
<%- include('pages/bookings', { isManager }) -%>
  <%# ======================= PROJECTS ======================= %>
  <% } else if (page === 'projects') { %>
<%- include('pages/projects') -%>
  <%# ======================= LEAD SOURCES ======================= %>
  <% } else if (page === 'sources') { %>
<%- include('pages/sources') -%>
  <%# ======================= USERS ======================= %>
  <% } else if (page === 'users') { %>
<%- include('pages/users') -%>
  <%# ======================= SETTINGS ======================= %>
  <% } else if (page === 'settings') { %>
<%- include('pages/settings') -%>
  <%# ======================= REPORTS ======================= %>
  <% } else if (page === 'reports') { %>
<%- include('pages/reports', { isAdminRole, isManager, statusColors }) -%>
  <%# ======================= AUDIT LOG ======================= %>
  <% } else if (page === 'audit') { %>
<%- include('pages/audit') -%>
  <%# ======================= TEAMS ======================= %>
  <% } else if (page === 'teams') { %>
<%- include('pages/teams') -%>
  <% } %>
<%- include('partials/complete-followup-modal') -%>
</main>
<%- include('partials/sidebar-script') -%>

<%- include('partials/chat-widget') -%>
</body>
</html>
